# Eventbrite private/personal OAuth token — https://www.eventbrite.com/platform/api-keys
EVENTBRITE_API_KEY=

# Ticketmaster Discovery API key — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Supabase project settings — public, safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, never expose to the browser.
# Used by /api/sync (via lib/supabase-admin.ts) to bypass RLS and upsert events.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret used to authorize calls to /api/sync (e.g. from Vercel Cron).
# Required in production — without it, anyone can trigger /api/sync.
CRON_SECRET=

# Eventbrite — Impact deep-link base ending in ?u= (after approval on impact.com).
# In Impact: Brands → Eventbrite → Create link → copy tracking URL, keep ?u=
# Example: https://eventbrite.pxf.io/c/123456/789012/3456?u=
EVENTBRITE_AFFILIATE_BASE=
NEXT_PUBLIC_EVENTBRITE_AFFILIATE_BASE=

# Public site URL (custom domain in production).
NEXT_PUBLIC_SITE_URL=https://barcelonagigguide.com

# Optional Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Ticketmaster — no env var needed. Link your Impact Publisher ID in the
# Ticketmaster Developer Portal profile; Discovery API URLs are wrapped automatically.
